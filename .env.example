# ===================================
# SALEM PRIMITIVE BAPTIST CHURCH
# Environment Variables Template
# ===================================

# ===================================
# REQUIRED - CORE FUNCTIONALITY
# ===================================

# Content (sermons, events, gallery, page copy, etc.) lives in Firestore —
# see lib/content.ts. No separate CMS project/token is needed; content is
# managed through the Firebase project below plus the admin panel (Phase 2)
# or scripts/seed-firestore-content.js for initial starter content.

# Authentication & Security - REQUIRED
# All authentication is Firebase Auth (see contexts/AuthContext.tsx). Roles
# live on each user's Firestore users/{uid} doc. There is no separate
# admin password — grant the admin role to a user's Firestore doc directly
# (Firebase Console, or a one-off script using the Admin SDK below).
ENCRYPTION_KEY=your_32_character_encryption_key_here
WEBHOOK_SECRET=your_random_webhook_secret_123

# Firebase Admin SDK (server-only) - REQUIRED for any /api/admin or
# /api/member route: they verify the caller's Firebase ID token and role
# server-side via this service account. Generate one in the Firebase
# Console under Project Settings -> Service Accounts -> Generate new
# private key, then copy the three fields below (keep the \n sequences
# literal in FIREBASE_ADMIN_PRIVATE_KEY, do not replace them with real
# newlines in the .env file).
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

# Bible API (Free) - REQUIRED
BIBLE_API_KEY=your_bible_api_key
NEXT_PUBLIC_BIBLE_API_KEY=your_bible_api_key

# ===================================
# OPTIONAL - ENHANCED FEATURES
# ===================================

# Firebase (Authentication & Hosting)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Email Configuration (Resend - https://resend.com)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Your Church Name <noreply@yourchurch.org>
ADMIN_EMAIL=admin@yourchurch.org

# SMS Configuration (Twilio - Free Trial)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payment Processing (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# CDN & Image Optimization (Cloudinary - Free)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CDN Alternative (Cloudflare - Free)
NEXT_PUBLIC_CDN_URL=https://your-domain.com
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id
CLOUDFLARE_ACCOUNT_ID=your_account_id

# Search (Algolia - Free Tier)
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_ADMIN_API_KEY=your_algolia_admin_key
NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY=your_algolia_search_key

# Analytics & Monitoring (Free)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
SENTRY_DSN=https://your-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn

# Maps Integration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Push Notifications (Firebase Messaging)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# ===================================
# COMPLIANCE & SECURITY
# ===================================

# GDPR Compliance
DATA_RETENTION_DAYS=2555  # 7 years for church records
GDPR_CONTACT_EMAIL=privacy@yourchurch.org

# Child Protection
CHILD_PROTECTION_ENABLED=true
BACKGROUND_CHECK_REQUIRED=true

# Two-Factor Authentication
TWO_FACTOR_SECRET=your_2fa_secret_key

# ===================================
# SETUP INSTRUCTIONS
# ===================================

# 1. Copy this file to .env.local
# 2. Replace all placeholder values with actual credentials
# 3. Never commit .env.local to version control
# 4. See README.md for detailed setup instructions

# ===================================
# FREE SERVICE PROVIDERS
# ===================================

# Bible API: https://bible-api.com (Free)
# Firebase: https://firebase.google.com (Free tier generous)
# Gmail SMTP: https://gmail.com (Free with app passwords)
# Twilio: https://twilio.com (Free trial $15 credit)
# Cloudinary: https://cloudinary.com (Free tier: 25k transformations)
# Algolia: https://algolia.com (Free tier: 10k searches/month)
# Google Analytics: https://analytics.google.com (Free)
# Sentry: https://sentry.io (Free tier: 5k errors/month)
# Vercel: https://vercel.com (Free tier for personal projects)