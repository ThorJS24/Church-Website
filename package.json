{
  "name": "salem-primitive-baptist-church",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "next lint",
    "setup": "node setup.js",
    "type-check": "tsc --noEmit",
    "deploy": "vercel --prod",
    "clean": "rm -rf .next out node_modules/.cache",
    "fresh-install": "rm -rf node_modules package-lock.json && npm install",
    "seed-content": "node scripts/seed-firestore-content.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "axe": "playwright test --grep=@axe",
    "lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.705.0",
    "@sentry/nextjs": "^8.55.0",
    "cloudinary": "^2.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.20",
    "next-pwa": "^5.6.0",
    "papaparse": "^5.4.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.54.2",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
